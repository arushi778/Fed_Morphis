# FedMorphis Environment Configuration Template
# Copy this file to .env and adjust values as needed. Do not commit .env.

# General Project Settings
FEDMORPHIS_ENV=development
FEDMORPHIS_SEED=42
FEDMORPHIS_DEVICE=auto

# Relative Paths (resolved from project root via pathlib)
FEDMORPHIS_DATA_DIR=data
FEDMORPHIS_CHECKPOINTS_DIR=checkpoints
FEDMORPHIS_EXPERIMENTS_DIR=experiments
FEDMORPHIS_LOGS_DIR=logs

# MLflow Tracking
MLFLOW_TRACKING_URI=experiments/mlruns
MLFLOW_EXPERIMENT_NAME=fedmorphis_baseline

# API & Dashboard Ports
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000
STREAMLIT_SERVER_PORT=8501

# Flower Federated Server Address (for multi-process mode)
FLOWER_SERVER_ADDRESS=127.0.0.1:8080

